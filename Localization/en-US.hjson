Mods: {
	WiitaMod: {
		Buffs: {
			HamisPetBuff: {
				DisplayName: Hamis
				Description: The Hamis is friendly :)
			}

			ShadowflameApparitionBuff: {
				DisplayName: Shadowflame Apparition
				Description: The Shadowflame Apparition will fight for you
			}

			BassBucketBuff: {
				DisplayName: Bass Stench
				Description: Bass Arrows deal 1% increased damage
			}

			GunDroneBuff: {
				DisplayName: EX-8 Guard Hound
				Description: The EX-8 Guard Hound will protect you
			}

			ProstheticDebuff: {
				DisplayName: Crippled
				Description: Walking hurts :(
			}
		}

		Items: {
			HealthFlower: {
				DisplayName: Health Flower
				Tooltip:
					'''
					Automatically use healing potions when taking lethal damage to prevent death
					Or when your health is under 50% & you take damage from an enemy
					'''
			}

			PhilosophersNecklace: {
				DisplayName: Philosopher's Necklace
				Tooltip:
					'''
					Reduces the cooldown of healing potions by 25%
					Increases length of invincibility after taking damage
					'''
			}

			SandlionAmmo: {
				DisplayName: Sandlion
				Tooltip: "'I wonder if I can shoot this...'"
			}

			IllegalRocketLauncherParts: {
				DisplayName: Illegal Rocket Launcher Parts
				Tooltip: "'Banned everywhere'"
			}

			HamisPetItem: {
				DisplayName: Chilly Egg
				Tooltip:
					'''
					Summons a Hamis
					'Does some mischievous acts around frogs'
					'''
			}

			HamisBannerItem: {
				DisplayName: Hamis Banner
				Tooltip: Nearby players get a bonus against: Hamis
			}

			BassBow: {
				DisplayName: Bass Bow
				Tooltip: Arrows turn into bass
			}

			GalacticBassBow: {
				DisplayName: Cosmic Bass Bow (old)
				Tooltip:
					'''
					The old Cosmic Bass Bow
					"Make a new one I guess"
					'''
			}

			JungleBassBow: {
				DisplayName: Leaf Bass Bow
				Tooltip:
					'''
					Arrows turn into Leaf Bass
					The Leaf Bass breaks into homing leaves
					The leaves ignore 20 enemy defense
					'''
			}

			MoltenBassBow: {
				DisplayName: Molten Bass Bow
				Tooltip:
					'''
					Arrows turn into Molten Bass that explode spreading fire
					The Molten Bass gets extinguished when touching water
					'''
			}

			CorruptionFlameLaser: {
				DisplayName: Cursed Flamelaser
				Tooltip:
					'''
					Uses gel for ammo
					'Is it a Flamethrower or a Laser?'
					'Stronger but more Sluggish!'
					'''
			}

			CrimsonFlameLaser: {
				DisplayName: Bloody Flamelaser
				Tooltip:
					'''
					Uses gel for ammo
					'Is it a Flamethrower or a Laser?'
					'Weaker but more Agile!'
					'''
			}

			SandlionLauncher: {
				DisplayName: Sandlion Launcher
				Tooltip: "'This is an amazing idea!'"
			}

			ShadowflameApparitionStaff: {
				DisplayName: Shadowflame Apparition Staff
				Tooltip: Summons a shadowflame apparition to fight for you
			}

			PalladinsShield: {
				DisplayName: Palladin's shield
				Tooltip: Make big palladin's shield that do damage :)
			}

			HamisHat: {
				DisplayName: HamHat
				Tooltip:
					'''
					'The drippiest drip there is'
					8% increased critical strike chance
					4% increased magic damage
					'''
				SetBonus: Increases maximum mana by 60
			}

			HamisStatueItem: {
				DisplayName: Hamis Statue
				Tooltip: ""
			}

			CosmicBassBow: {
				DisplayName: Cosmic Bass Bow
				Tooltip:
					'''
					Arrows turn into Cosmic Bass
					Charging the weapon partially shoots bursts of Cosmic Bass
					Charging the weapon fully shoots a strong homing Cosmic Bass
					The strong Cosmic Bass explodes into homing Cosmic Projectiles
					'''
			}

			FriedSeagull: {
				DisplayName: Fried Seagull
				Tooltip:
					'''
					'Vermin with wings? Chicken of the sea? Or just an opportunity missed?'
					{$CommonItemTooltip.MediumStats}
					'''
			}

			AstralAlloy: {
				DisplayName: Astral Alloy
				Tooltip: ""
			}

			ThundercoreRifle: {
				DisplayName: Thundercore Rifle
				Tooltip: "'big thunder boom lightning amazing'"
			}

			MedievalProsthetic: {
				DisplayName: Medieval Prosthetic
				Tooltip:
					'''
					100% increased flight time
					30% increased flight movement speed
					'Walking with this hurts so much it makes you stay off the ground'
					'''
			}

			InfernalAlmanac: {
				DisplayName: Infernal Almanac
				Tooltip:
					'''
					Summons Infernal Fireballs to circle around you when charging
					When you stop charging you shoot out the Fireballs
					Once fully charged the Fireballs explode on impact and home onto enemies
					'''
			}

			BassBucketItem: {
				DisplayName: Bass Bucket
				Tooltip: Increases bass arrows damage by 1%
			}

			PressureWasher: {
				DisplayName: Pressure Washer
				Tooltip:
					'''
					Ignores 30% of enemy defense
					'Wash your enemies with 3000 PSI water!'
					'''
			}

			DeepcoreFlareItem: {
				DisplayName: Deepcore Flare
				Tooltip: ""
			}

			DeepcoreFlareGun: {
				DisplayName: Deepcore Flare Gun
				Tooltip:
					'''
					Shoots out Deepcore Flares
					Has a 1 second cooldown
					'''
			}

			GunDroneItem: {
				DisplayName: EX-8 Guard Hound Controller
				Tooltip:
					'''
					Summons an EX-8 Guard Hound drone to protect you
					Right click to change between weapon modes
					Requires 2 minion slots
					'''
			}

			SandPouch: {
				DisplayName: Sand Pouch
				Tooltip: ""
			}

			TestWeapon: {
				DisplayName: Test Weapon
				Tooltip: ""
			}

			FlameBlaster: {
				DisplayName: Flame Blaster
				Tooltip: ""
			}
		}

