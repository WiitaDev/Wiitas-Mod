			}

			BassBow: {
				DisplayName: Bass Bow
				Tooltip: Arrows turn into bass
			}

			JungleBassBow: {
				DisplayName: Leaf Bass Bow
				Tooltip:
					'''
					Arrows turn into Leaf Bass
					The Leaf Bass breaks into homing leaves
					The leaves ignore 20 enemy defense
					'''
			}

			MoltenBassBow: {
				DisplayName: Molten Bass Bow
				Tooltip:
					'''
					Arrows turn into Molten Bass that explode spreading fire
					The Molten Bass gets extinguished when touching water
					'''
			}

			CorruptionFlameLaser: {
				DisplayName: Cursed Flamelaser
				Tooltip:
					'''
					Uses gel for ammo
					'Is it a Flamethrower or a Laser?'
					'Stronger but more Sluggish!'
					'''
			}

			CrimsonFlameLaser: {
				DisplayName: Bloody Flamelaser
				Tooltip:
					'''
					Uses gel for ammo
					'Is it a Flamethrower or a Laser?'
					'Weaker but more Agile!'
					'''
			}

			SandlionLauncher: {
				DisplayName: Sandlion Launcher
				Tooltip: "'This is an amazing idea!'"
			}

			ShadowflameApparitionStaff: {
				DisplayName: Shadowflame Apparition Staff
				Tooltip: Summons a shadowflame apparition to fight for you
			}

			PalladinsShield: {
				DisplayName: Palladin's shield
				Tooltip:
